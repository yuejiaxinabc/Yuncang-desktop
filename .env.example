# 云仓桌面作业端 —— 环境变量文件
# 复制成 .env 放在：程序同目录 / %APPDATA%\云仓客户端\ / 启动参数 --env <路径>

# 云仓服务地址（可带端口、可带 /api/v1/open，客户端会自动归一化）
CW_BASE_URL=https://yc.yuejiaxin.ln.cn

# 云仓 API 密钥：后台「设置 → API 管理」创建，明文只显示一次
# 作业范围完全由这把密钥的 scope 与授权仓库决定
CW_API_KEY=yc_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 可选：单次请求超时（毫秒）
CW_TIMEOUT_MS=20000
